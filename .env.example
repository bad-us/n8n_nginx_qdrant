# ============================================================================
#  ЕДИНЫЙ ФАЙЛ НАСТРОЕК СТЕКА n8n + nginx + Qdrant
#  Скопируйте в .env и заполните:  cp .env.example .env
#  Секреты сгенерировать:          ./scripts/gen-secrets.sh
# ============================================================================

# ---------------------------------------------------------------------------
#  ОБЩЕЕ
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=n8n-stack
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
#  ДОМЕНЫ (должны уже резолвиться в IP этого сервера!)
# ---------------------------------------------------------------------------
N8N_DOMAIN=n8n.example.com
QDRANT_DOMAIN=qdrant.example.com

# Имя линии сертификата Let's Encrypt.
# ОБЯЗАТЕЛЬНО должно совпадать с N8N_DOMAIN (сертификат один на оба домена).
TLS_CERT_NAME=n8n.example.com

# E-mail для Let's Encrypt (уведомления об истечении)
LETSENCRYPT_EMAIL=admin@example.com
# 1 = тестовый контур LE (не тратит лимиты, сертификат НЕ будет доверенным)
LETSENCRYPT_STAGING=0

# ---------------------------------------------------------------------------
#  ПОРТЫ
# ---------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
N8N_PORT=5678
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------------------------------------------------------------------------
#  СЕКРЕТЫ  (заполняются автоматически: ./scripts/gen-secrets.sh)
#  ВАЖНО: N8N_ENCRYPTION_KEY нельзя менять после первого запуска —
#         иначе все сохранённые credentials в n8n перестанут расшифровываться.
# ---------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME
QDRANT_READONLY_API_KEY=CHANGE_ME_TOO

# ---------------------------------------------------------------------------
#  ВЕРСИИ ОБРАЗОВ (проверено на 2026-10-01)
# ---------------------------------------------------------------------------
N8N_VERSION=2.41.5
NGINX_VERSION=stable-alpine
QDRANT_VERSION=v1.19.1
CERTBOT_VERSION=latest

# ---------------------------------------------------------------------------
#  ИМЕНА КОНТЕЙНЕРОВ / СЕТЕЙ / ТОМОВ
# ---------------------------------------------------------------------------
N8N_CONTAINER_NAME=n8n
QDRANT_CONTAINER_NAME=qdrant
NGINX_CONTAINER_NAME=nginx
CERTBOT_CONTAINER_NAME=certbot

NET_EDGE=n8n_edge
NET_DATA=n8n_data

VOL_N8N_DATA=n8n_data
VOL_QDRANT_DATA=qdrant_data
VOL_NGINX_CACHE=nginx_cache
VOL_LETSENCRYPT=letsencrypt_certs
VOL_CERTBOT_WWW=certbot_www

# ---------------------------------------------------------------------------
#  N8N
# ---------------------------------------------------------------------------
# http или https. На первом запуске (до выпуска сертификата) поставьте http,
# после init-letsencrypt.sh — https и перезапустите: docker compose up -d
N8N_PROTOCOL=https
# Количество доверенных прокси перед n8n (nginx = 1)
N8N_PROXY_HOPS=1
# true = cookie только по HTTPS. При N8N_PROTOCOL=http поставьте false
N8N_SECURE_COOKIE=true
# Максимальный размер входящего запроса в MiB (вебхуки с файлами)
N8N_PAYLOAD_SIZE_MAX=64
# Через сколько часов удалять старые выполнения
N8N_EXECUTIONS_MAX_AGE=336

# ---------------------------------------------------------------------------
#  NGINX
# ---------------------------------------------------------------------------
NGINX_CLIENT_MAX_BODY_SIZE=64m
NGINX_HSTS_MAX_AGE=31536000
NGINX_ACME_WEBROOT=/var/www/certbot
NGINX_TLS_PROTOCOLS="TLSv1.2 TLSv1.3"
NGINX_TLS_CIPHERS="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305"
NGINX_SERVER_TOKENS=off

# ---------------------------------------------------------------------------
#  QDRANT
# ---------------------------------------------------------------------------
QDRANT_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
#  HEALTHCHECK / ЛОГИ
# ---------------------------------------------------------------------------
HEALTHCHECK_INTERVAL=15s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
